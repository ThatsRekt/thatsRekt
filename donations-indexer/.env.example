# =============================================================================
# donations-indexer — Portal ingestion configuration
# =============================================================================

# One Production Chain per scheduled container.
CHAIN_SLUG=ethereum

# Historical data is fetched only from the configured Portal Dataset Endpoint.
# This generic base is combined with the chain-selected dataset at runtime.
PORTAL_URL=https://portal.example.test/datasets
# Optional. Blank or omitted sends no authentication header.
# PORTAL_API_KEY=

# JSON-RPC is used only to read the bounded finalized head for this chain.
RPC_ETHEREUM_HTTP=https://ethereum.rpc.example.test

# PostgreSQL connection string for the donations database.
DONATIONS_DB_URL=postgres://postgres:postgres@localhost:5432/thatsrekt_donations

# Maximum acquired-lock runtime in seconds. Scheduler cadence permits 1,500.
MAX_RUNTIME_SECONDS=1500

# Optional per-chain test override. Production defaults are pinned in
# src/chainConfig.ts.
# START_BLOCK_ETHEREUM=19000000
# FINALITY_CONFIRMATION=75

# ENS resolution is a control-plane read. If absent, the processor uses its
# canonical seed donee; it never substitutes JSON-RPC for Portal history.
# ENS_RPC_URL=https://ethereum.rpc.example.test
# DONEE_OVERRIDE=0x59E4DBc95BD312A882Bb36b7f3E8298682340679

# Test-only Postgres endpoints for deterministic captured-fixture harnesses.
# TEST_DB_URL=postgres://postgres:postgres@localhost:5433/donations_test
# PORTAL_INTEGRITY_TEST_DB_URL=postgres://postgres:postgres@localhost:5433/donations_portal_integrity_test
# TEST_SUPERUSER_URL=postgres://postgres:postgres@localhost:5433/postgres
