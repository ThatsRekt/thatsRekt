# =============================================================================
# thatsRekt Registry Indexer — Portal configuration
# =============================================================================

# --- Postgres ----------------------------------------------------------------
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Portal Production Chain ingestion ---------------------------------------
# The selected Production Chain appends its exact dataset slug to this generic
# base at runtime. Set this per processor container when datasets are isolated.
PORTAL_URL=https://portal.example.test/datasets
# Optional. Blank or omitted sends no x-api-key header.
# PORTAL_API_KEY=

# Contract and start block for each Production Chain.
CONTRACT_ETHEREUM=0x0000000000000000000000000000000000000000
START_BLOCK_ETHEREUM=0
CONTRACT_BASE=0x0000000000000000000000000000000000000000
START_BLOCK_BASE=0
CONTRACT_ARBITRUM=0x0000000000000000000000000000000000000000
START_BLOCK_ARBITRUM=0
CONTRACT_OPTIMISM=0x0000000000000000000000000000000000000000
START_BLOCK_OPTIMISM=0
CONTRACT_BSC=0x0000000000000000000000000000000000000000
START_BLOCK_BSC=0
CONTRACT_POLYGON=0x0000000000000000000000000000000000000000
START_BLOCK_POLYGON=0

# --- Explicit RPC-only development paths -------------------------------------
# Local Anvil Forks and testnets do not use Portal configuration.
RPC_ANVIL_ETH_HTTP=http://anvil-eth:8545
CONTRACT_ANVIL_ETH=0x0000000000000000000000000000000000000000
START_BLOCK_ANVIL_ETH=0
RPC_ANVIL_BASE_HTTP=http://anvil-base:8545
CONTRACT_ANVIL_BASE=0x0000000000000000000000000000000000000000
START_BLOCK_ANVIL_BASE=0
RPC_SEPOLIA_HTTP=https://sepolia.rpc.example.test
CONTRACT_SEPOLIA=0x0000000000000000000000000000000000000000
START_BLOCK_SEPOLIA=0
RPC_BASE_SEPOLIA_HTTP=https://base-sepolia.rpc.example.test
CONTRACT_BASE_SEPOLIA=0x0000000000000000000000000000000000000000
START_BLOCK_BASE_SEPOLIA=0

# Mesh keeps the existing per-chain GraphQL topology.
MESH_CHAINS=anvil-eth,anvil-base,sepolia,base,optimism
MESH_PORT=4350
